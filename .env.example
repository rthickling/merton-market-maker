# Python used by Docker/just lives in cpp/.merton-build.env (PYTHON_VERSION=3.14.8 default).

# Copy to .env. Command-line flags and env vars override these.

# Live demo (cd cpp && just demo)
# USD-M perps: BTCUSDT ETHUSDT SOLUSDT XRPUSDT XAUUSDT
MERTON_SYMBOL=BTCUSDT
MERTON_MARKET=futures

# Optional historical warmup: directory or file of CSV/Parquet with time + price.
# If unset or missing, the demo starts from the seed params below.
# MERTON_MARKET_MAKER_DATA_PATH=./data/trades

# Optional Merton seed params for the C++ online calibrator.
# MERTON_SIGMA=0.44
# MERTON_LAMBDA=20.0
# MERTON_MU_J=0.003
# MERTON_DELTA_J=0.01

# Paper-quote width (live demo and ProfitView wrapper; the replay takes flags instead).
# Half-spread = the largest of half the market spread, the floor, and
# mid x multiplier x the fitted model's log-return standard deviation over the
# risk horizon. Demonstration defaults, not calibrated trading settings.
# MERTON_MIN_HALF_SPREAD_BPS=2.0
# MERTON_RISK_HORIZON_SECONDS=60
# MERTON_RISK_MULTIPLIER=1.0
# At most one quote line per this many seconds, and one no-jump diagnostic line
# per ten times as many (0: no limit).
# MERTON_PRINT_SECONDS=1
