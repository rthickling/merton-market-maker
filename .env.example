# Python used by Docker/just lives in cpp/.merton-build.env (PYTHON_VERSION=3.12.11 default).
# ProfitView module ABI: PYTHON_VERSION=3.9.25

# Copy to .env. Command-line flags and env vars override these.

# Live demo (cd cpp && just demo)
# USD-M perps: BTCUSDT ETHUSDT SOLUSDT XRPUSDT XAUUSDT
MERTON_SYMBOL=BTCUSDT
MERTON_MARKET=futures

# Optional historical warmup: directory or file of CSV/Parquet with time + price.
# If unset or missing, the demo starts from the seed params below.
# MERTON_MARKET_MAKER_DATA_PATH=./data/trades

# Optional Merton seed params for the C++ online calibrator.
# MERTON_SIGMA=0.44
# MERTON_LAMBDA=20.0
# MERTON_MU_J=0.003
# MERTON_DELTA_J=0.01
