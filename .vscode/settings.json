{
  // Shared settings only. Machine-specific paths belong in user settings.
  // The build runs in Docker through `just`, so CMake Tools must not configure on the host.
  "cmake.sourceDirectory": "${workspaceFolder}/cpp",
  "cmake.configureOnOpen": false,
  // The Microsoft C/C++ engine cannot parse C++26 reflection.
  "C_Cpp.errorSquiggles": "disabled"
}
