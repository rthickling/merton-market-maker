# Copy this file to .merton-build.env or run: just setup-defaults
# These values are used by cpp/justfile unless overridden by environment variables.

COMPILER=clang
MERTON_PYTHON_BINDING=nanobind
DOCKER_NETWORK=host
# Optional override; defaults: merton-refl-build (clang) or merton-gcc-16 (gcc)
# IMAGE_NAME=
# Deploy copy is explicit only: just copy-module
MODULE_DEST_DIR=
