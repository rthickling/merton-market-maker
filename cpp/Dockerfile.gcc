# GCC 16.2 reflection toolchain + QuantLib (libstdc++) + Python 3.9.
# Target: linux/amd64. No -march=native.
ARG UBUNTU_VERSION=22.04
ARG PYTHON_VERSION=3.9
ARG QUANTLIB_VERSION=1.33
ARG GCC_VERSION=16.2.0
# Official sha512.sum for gcc-16.2.0.tar.xz (sourceware.org/ftp/gcc/releases/gcc-16.2.0/)
ARG GCC_TARBALL_SHA512=c51c30ca7422d0cbecf504b2e0f33c3aca31e0f90a76b65217f465163fa6fa17b3f5de39e145c47e5bab90ac0ce7fff3b03c8d553ae36e01faaea5a50f8648d1
# Computed locally from QuantLib-1.33.tar.gz release asset.
ARG QUANTLIB_TARBALL_SHA256=4810d789261eb36423c7d277266a6ee3b28a3c05af1ee0d45544ca2e0e8312bd

# --- STAGE 1: Build released GCC from official source ---
FROM ubuntu:${UBUNTU_VERSION} AS gcc-builder
SHELL ["/bin/bash", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG GCC_VERSION
ARG GCC_TARBALL_SHA512
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl xz-utils file \
    flex bison texinfo \
    libgmp-dev libmpfr-dev libmpc-dev libisl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN set -euo pipefail && \
    curl -fsSL -o gcc-${GCC_VERSION}.tar.xz \
      https://sourceware.org/pub/gcc/releases/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz && \
    echo "${GCC_TARBALL_SHA512}  gcc-${GCC_VERSION}.tar.xz" | sha512sum -c - && \
    tar -xf gcc-${GCC_VERSION}.tar.xz && \
    mkdir gcc-build && cd gcc-build && \
    ../gcc-${GCC_VERSION}/configure \
      --prefix=/opt/gcc-16 \
      --disable-multilib \
      --enable-languages=c,c++ \
      --disable-bootstrap \
      --disable-nls && \
    make -j"$(nproc)" && \
    make install-strip && \
    cd / && rm -rf /tmp/gcc-${GCC_VERSION} /tmp/gcc-${GCC_VERSION}.tar.xz /tmp/gcc-build

# --- STAGE 2: Python + QuantLib with GCC 16 / libstdc++ ---
FROM ubuntu:${UBUNTU_VERSION}
SHELL ["/bin/bash", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION
ARG QUANTLIB_VERSION
ARG QUANTLIB_TARBALL_SHA256
ENV TZ=UTC
ENV PYTHON_VERSION=${PYTHON_VERSION}
ENV QUANTLIB_VERSION=${QUANTLIB_VERSION}

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common ca-certificates curl wget gnupg \
    && add-apt-repository universe \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config \
    git \
    python${PYTHON_VERSION} python${PYTHON_VERSION}-dev python${PYTHON_VERSION}-distutils python3-pip \
    libboost-all-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-docker.txt /tmp/requirements-docker.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements-docker.txt && \
    python${PYTHON_VERSION} -m pip install --no-cache-dir -r /tmp/requirements-docker.txt && \
    rm -f /tmp/requirements-docker.txt

RUN curl -sSf https://just.systems/install.sh | bash -s -- --to /usr/local/bin

COPY --from=gcc-builder /opt/gcc-16 /opt/gcc-16
ENV PATH="/opt/gcc-16/bin:$PATH"
ENV LD_LIBRARY_PATH="/opt/gcc-16/lib64"
ENV CC="/opt/gcc-16/bin/gcc"
ENV CXX="/opt/gcc-16/bin/g++"

# QuantLib with the same g++ / libstdc++ (do not mix with libc++).
RUN set -euo pipefail && cd /tmp && \
    wget -q -O QuantLib-${QUANTLIB_VERSION}.tar.gz \
      https://github.com/lballabio/QuantLib/releases/download/v${QUANTLIB_VERSION}/QuantLib-${QUANTLIB_VERSION}.tar.gz && \
    echo "${QUANTLIB_TARBALL_SHA256}  QuantLib-${QUANTLIB_VERSION}.tar.gz" | sha256sum -c - && \
    tar xzf QuantLib-${QUANTLIB_VERSION}.tar.gz && cd QuantLib-${QUANTLIB_VERSION} && \
    sed -i 's/boost::numeric_cast<Integer>(/static_cast<Integer>(/g' ql/time/daycounters/yearfractiontodate.cpp && \
    CPPFLAGS="-DQL_USE_STD_SHARED_PTR" \
    CXXFLAGS="-O3 -fPIC -ffunction-sections -fdata-sections -std=c++14" \
    ./configure --prefix=/opt/ql_install --with-pic --disable-shared --enable-static \
      --disable-test-suite --disable-examples && \
    make -j"$(nproc)" && make install && \
    cd / && rm -rf /tmp/QuantLib-${QUANTLIB_VERSION} /tmp/QuantLib-${QUANTLIB_VERSION}.tar.gz

WORKDIR /workspace
