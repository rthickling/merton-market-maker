test-compiler-matrix:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  compiler="$COMPILER"
  pyver="$PYTHON_VERSION"
  for binding in nanobind pybind11; do
    echo "=== COMPILER=$compiler PYTHON_VERSION=$pyver MERTON_PYTHON_BINDING=$binding ==="
    COMPILER="$compiler" PYTHON_VERSION="$pyver" MERTON_PYTHON_BINDING="$binding" just test-host
  done

test-matrix:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  pyver="$PYTHON_VERSION"
  for compiler in clang gcc; do
    for binding in nanobind pybind11; do
      echo "=== MATRIX: COMPILER=$compiler PYTHON_VERSION=$pyver MERTON_PYTHON_BINDING=$binding ==="
      COMPILER="$compiler" PYTHON_VERSION="$pyver" MERTON_PYTHON_BINDING="$binding" just test-host
    done
  done

# Also build the hand-written nanobind module (and, with GCC, the shared core that cppyy calls),
# then run all tests, including equivalence checks.
test-manual-bindings: docker-build
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  if [[ "$MERTON_PYTHON_BINDING" != "nanobind" ]]; then
    echo "merton_manual_bindings uses nanobind; run with MERTON_PYTHON_BINDING=nanobind." >&2
    exit 1
  fi
  shared_core=OFF
  import_check="import merton_manual_bindings, merton_online_calibrator"
  if [[ "$COMPILER" == "gcc" ]]; then
    shared_core=ON
    import_check="$import_check; from scripts import merton_cppyy"
  fi
  docker_network="${DOCKER_NETWORK:-host}"
  repo="$(cd "{{root}}/.." && pwd)"
  manual_dir="$build_dir-with-manual"
  docker run --network "$docker_network" --rm \
    -v "{{root}}:/workspace" -v "$repo:/repo" "$image_name" bash -lc "
      set -euo pipefail
      rm -rf /workspace/$manual_dir
      cmake -S /workspace -B /workspace/$manual_dir -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE=/workspace/$toolchain \
        -DPython3_EXECUTABLE=$PYTHON_BIN \
        -DMERTON_PYTHON_BINDING=nanobind \
        -DMERTON_BUILD_MANUAL_BINDINGS=ON \
        -DMERTON_BUILD_SHARED_CORE=$shared_core
      cmake --build /workspace/$manual_dir
      export PYTHONPATH=/workspace/$manual_dir:/repo
      $PYTHON_BIN -c '$import_check'
      $PYTHON_BIN -m pytest /workspace/tests
    "

# Time readable Python and Numba against the C++ calibrator behind reflected and hand-written
# bindings and through cppyy (offline; GCC image only).
bench *ARGS:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  if [[ "$MERTON_PYTHON_BINDING" != "nanobind" ]]; then
    echo "The benchmark compares nanobind modules; run with MERTON_PYTHON_BINDING=nanobind." >&2
    exit 1
  fi
  if [[ "$COMPILER" != "gcc" ]]; then
    echo "The benchmark includes cppyy, which needs the GCC image; run with COMPILER=gcc." >&2
    exit 1
  fi
  repo="$(cd "{{root}}/.." && pwd)"
  manual_dir="$build_dir-with-manual"
  commit="$(git -C "$repo" describe --always --dirty 2>/dev/null || echo unknown)"
  docker image inspect "$image_name" >/dev/null 2>&1 || just docker-build
  docker run --network none --rm -e BENCH_COMMIT="$commit" \
    -v "{{root}}:/workspace" -v "$repo:/repo:ro" "$image_name" bash -lc "
      set -euo pipefail
      cmake -S /workspace -B /workspace/$manual_dir -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE=/workspace/$toolchain \
        -DPython3_EXECUTABLE=$PYTHON_BIN \
        -DMERTON_PYTHON_BINDING=nanobind \
        -DMERTON_BUILD_MANUAL_BINDINGS=ON \
        -DMERTON_BUILD_SHARED_CORE=ON > /dev/null
      cmake --build /workspace/$manual_dir
      PYTHONPATH=/workspace/$manual_dir:/repo $PYTHON_BIN /repo/scripts/bench_calibration.py \
        --out /workspace/build/bench {{ARGS}}
    "

# Smart defaults:
# - On host (docker available): run host recipes
# - In container (docker unavailable): run local recipes
build:
  if command -v docker >/dev/null 2>&1; then just build-host; else just build-local; fi

test:
  if command -v docker >/dev/null 2>&1; then just test-host; else just test-local; fi

# Unlike `just build`, which starts from scratch, keeps the build directory.
# Incremental build of the selected combination: recompiles only what changed.
rebuild:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  if command -v docker >/dev/null 2>&1; then
    docker image inspect "$image_name" >/dev/null 2>&1 || just docker-build
    docker run --network none --rm -v "{{root}}:/workspace" "$image_name" bash -lc "
      set -euo pipefail
      if [ ! -f /workspace/$build_dir/build.ninja ]; then
        cmake -S /workspace -B /workspace/$build_dir -G Ninja \
          -DCMAKE_TOOLCHAIN_FILE=/workspace/$toolchain \
          -DPython3_EXECUTABLE=$PYTHON_BIN \
          -DMERTON_PYTHON_BINDING=$MERTON_PYTHON_BINDING
      fi
      TIMEFORMAT='rebuilt in %1R s'
      time cmake --build /workspace/$build_dir
    "
  else
    if [ ! -f "{{root}}/$build_dir/build.ninja" ]; then
      cmake -S "{{root}}" -B "{{root}}/$build_dir" -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE="{{root}}/$toolchain" \
        -DPython3_EXECUTABLE="$PYTHON_BIN" \
        -DMERTON_PYTHON_BINDING="$MERTON_PYTHON_BINDING"
    fi
    TIMEFORMAT='rebuilt in %1R s'
    time cmake --build "{{root}}/$build_dir"
  fi

# Replay synthetic (or recorded) ticks through the calibrator (offline).
replay *ARGS:
  #!/usr/bin/env bash
  set -euo pipefail
  just rebuild >/dev/null
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  repo="$(cd "{{root}}/.." && pwd)"
  docker_env=()
  extra_mounts=()
  host_path="${MERTON_MARKET_MAKER_DATA_PATH:-}"
  prev=""
  for arg in {{ARGS}}; do
    if [[ "$prev" == "--data-path" ]]; then
      host_path="$arg"
    fi
    prev="$arg"
  done
  if [[ -n "$host_path" ]]; then
    if [[ "$host_path" != /* ]]; then
      host_path="$repo/$host_path"
    fi
    if [[ -e "$host_path" ]]; then
      abs="$(readlink -f "$host_path")"
      # Bind the parent directory: some Docker setups turn a file bind into a directory.
      if [[ -f "$abs" ]]; then
        mount_src="$(dirname "$abs")"
      else
        mount_src="$abs"
      fi
      extra_mounts+=(-v "$mount_src:$mount_src:ro")
      docker_env+=(-e "MERTON_MARKET_MAKER_DATA_PATH=$abs")
      args=()
      prev=""
      for arg in {{ARGS}}; do
        if [[ "$prev" == "--data-path" ]]; then
          args+=("$abs")
        else
          args+=("$arg")
        fi
        prev="$arg"
      done
    else
      docker_env+=(-e "MERTON_MARKET_MAKER_DATA_PATH=$host_path")
      args=({{ARGS}})
    fi
  else
    args=({{ARGS}})
  fi
  if command -v docker >/dev/null 2>&1; then
    docker run --network none --rm "${docker_env[@]}" \
      -v "{{root}}:/workspace" -v "$repo:/repo:ro" "${extra_mounts[@]}" "$image_name" bash -lc \
      "PYTHONPATH=/workspace/$build_dir:/repo $PYTHON_BIN /repo/scripts/replay_demo.py ${args[*]}"
  else
    PYTHONPATH="{{root}}/$build_dir:$repo" "$PYTHON_BIN" "$repo/scripts/replay_demo.py" {{ARGS}}
  fi

# Print the reflected Python interface of the built module (offline).
api: rebuild
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  if command -v docker >/dev/null 2>&1; then
    repo="$(cd "{{root}}/.." && pwd)"
    docker run --network none --rm -v "{{root}}:/workspace" -v "$repo:/repo:ro" "$image_name" bash -lc \
      "PYTHONPATH=/workspace/$build_dir $PYTHON_BIN /repo/scripts/show_api.py"
  else
    PYTHONPATH="{{root}}/$build_dir" "$PYTHON_BIN" "{{root}}/../scripts/show_api.py"
  fi
