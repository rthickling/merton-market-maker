set shell := ["bash", "-cu"]

module_name := "merton_online_calibrator.so"
root := justfile_directory()

default:
  @just test

# Shared env resolution used by recipes (COMPILER=clang|gcc; default clang until GCC verified).
# Effective build dir: build/<compiler_tag>-<binding>

setup-defaults:
  #!/usr/bin/env bash
  set -euo pipefail
  cfg="{{root}}/.merton-build.env"
  if [ -f "$cfg" ]; then
    printf "A defaults file already exists at %s. Overwrite it? [y/N]: " "$cfg"
    read -r overwrite
    case "$overwrite" in
      y|Y|yes|YES) ;;
      *) echo "Keeping existing defaults."; exit 0 ;;
    esac
  fi

  echo
  echo "Merton Market Maker build setup"
  echo "This stores your preferred build defaults in cpp/.merton-build.env."
  echo "Environment variables still override these values when needed."
  echo

  echo "1) Compiler toolchain (COMPILER)"
  echo "   - clang: Bloomberg Clang P2996 + libc++ (current default)"
  echo "   - gcc: released GCC 16.2 + libstdc++"
  while :; do
    printf "   Compiler [clang]: "
    read -r compiler
    compiler=${compiler:-clang}
    case "$compiler" in
      clang|gcc) break ;;
      *) echo "   Please enter 'clang' or 'gcc'." ;;
    esac
  done

  echo
  echo "2) Python binding backend (MERTON_PYTHON_BINDING)"
  echo "   - nanobind: current default"
  echo "   - pybind11: alternative backend"
  while :; do
    printf "   Binding backend [nanobind]: "
    read -r binding
    binding=${binding:-nanobind}
    case "$binding" in
      nanobind|pybind11) break ;;
      *) echo "   Please enter 'nanobind' or 'pybind11'." ;;
    esac
  done

  echo
  echo "3) Docker networking mode (DOCKER_NETWORK)"
  while :; do
    printf "   Docker network [host]: "
    read -r docker_network
    docker_network=${docker_network:-host}
    case "$docker_network" in
      host|bridge) break ;;
      *) echo "   Please enter 'host' or 'bridge'." ;;
    esac
  done

  echo
  echo "4) Optional module copy destination (MODULE_DEST_DIR)"
  echo "   Used only by: just copy-module (build/test do not copy)."
  printf "   Destination directory [blank]: "
  read -r module_dest_dir

  printf '%s\n' \
    '# Generated by: just setup-defaults' \
    '# Override any of these temporarily by prefixing the just command with env vars.' \
    "COMPILER=$compiler" \
    "MERTON_PYTHON_BINDING=$binding" \
    "DOCKER_NETWORK=$docker_network" \
    "MODULE_DEST_DIR=$module_dest_dir" \
    > "$cfg"

  echo
  echo "Saved defaults to $cfg"
  just show-defaults

show-defaults:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  binding="${MERTON_PYTHON_BINDING:-nanobind}"
  docker_network="${DOCKER_NETWORK:-host}"
  module_dest_dir="${MODULE_DEST_DIR:-}"
  case "$compiler" in
    clang) compiler_tag="clang-p2996"; image_name="${IMAGE_NAME:-merton-refl-build}"; dockerfile="Dockerfile"; toolchain="toolchain-p2996.cmake" ;;
    gcc) compiler_tag="gcc-16"; image_name="${IMAGE_NAME:-merton-gcc-16}"; dockerfile="Dockerfile.gcc"; toolchain="toolchain-gcc-16.cmake" ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac
  build_dir="build/${compiler_tag}-${binding}"
  echo "Effective defaults:"
  echo "  COMPILER=$compiler"
  echo "  IMAGE_NAME=$image_name"
  echo "  DOCKERFILE=$dockerfile"
  echo "  TOOLCHAIN=$toolchain"
  echo "  BUILD_DIR=$build_dir"
  echo "  MERTON_PYTHON_BINDING=$binding"
  echo "  DOCKER_NETWORK=$docker_network"
  echo "  MODULE_DEST_DIR=$module_dest_dir"

docker-build:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  docker_network="${DOCKER_NETWORK:-host}"
  build_network="$docker_network"
  if [[ "$build_network" == "bridge" ]]; then
    build_network="default"
  fi
  case "$compiler" in
    clang) image_name="${IMAGE_NAME:-merton-refl-build}"; dockerfile="Dockerfile" ;;
    gcc) image_name="${IMAGE_NAME:-merton-gcc-16}"; dockerfile="Dockerfile.gcc" ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac
  no_cache_args=()
  if [[ "${DOCKER_NO_CACHE:-0}" == "1" ]]; then
    no_cache_args+=(--pull --no-cache)
  fi
  docker build "${no_cache_args[@]}" --platform=linux/amd64 --network="$build_network" -t "$image_name" \
    -f "{{root}}/$dockerfile" \
    "{{root}}"

docker-build-clean:
  DOCKER_NO_CACHE=1 just docker-build

versions: docker-build
  #!/usr/bin/env bash
  set -euo pipefail
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  case "$compiler" in
    clang) image_name="${IMAGE_NAME:-merton-refl-build}" ;;
    gcc) image_name="${IMAGE_NAME:-merton-gcc-16}" ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac
  docker run --rm "$image_name" merton-build-info

# Compile/run the reflection probe with the selected compiler image.
probe: docker-build
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  docker_network="${DOCKER_NETWORK:-host}"
  case "$compiler" in
    clang)
      image_name="${IMAGE_NAME:-merton-refl-build}"
      docker run --network "$docker_network" --rm -v "{{root}}:/workspace" -w /workspace "$image_name" bash -lc '
        set -euo pipefail
        clang++ -std=c++2c -freflection -freflection-latest -fexpansion-statements \
          -stdlib=libc++ -nostdinc++ -O2 \
          -I/opt/clang-p2996/include/c++/v1 \
          -I/opt/clang-p2996/include/x86_64-unknown-linux-gnu/c++/v1 \
          -nostdlib++ \
          /opt/clang-p2996/lib/x86_64-unknown-linux-gnu/libc++.a \
          /opt/clang-p2996/lib/x86_64-unknown-linux-gnu/libc++abi.a \
          -lm -lc -lpthread -lgcc_s \
          -o /tmp/reflection_probe probes/reflection_probe.cpp
        /tmp/reflection_probe
      '
      ;;
    gcc)
      image_name="${IMAGE_NAME:-merton-gcc-16}"
      docker run --network "$docker_network" --rm -v "{{root}}:/workspace" -w /workspace "$image_name" bash -lc '
        set -euo pipefail
        g++ -std=c++26 -freflection -fconstexpr-ops-limit=67108864 -O2 \
          -o /tmp/reflection_probe probes/reflection_probe.cpp
        /tmp/reflection_probe
      '
      ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac

build-host: docker-build
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  binding="${MERTON_PYTHON_BINDING:-nanobind}"
  docker_network="${DOCKER_NETWORK:-host}"
  case "$compiler" in
    clang) compiler_tag="clang-p2996"; image_name="${IMAGE_NAME:-merton-refl-build}"; toolchain="toolchain-p2996.cmake" ;;
    gcc) compiler_tag="gcc-16"; image_name="${IMAGE_NAME:-merton-gcc-16}"; toolchain="toolchain-gcc-16.cmake" ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac
  build_dir="build/${compiler_tag}-${binding}"
  docker run --network "$docker_network" --rm -v "{{root}}:/workspace" "$image_name" bash -lc "
    set -euo pipefail
    rm -rf /workspace/$build_dir
    cmake -S /workspace -B /workspace/$build_dir -G Ninja \
      -DCMAKE_TOOLCHAIN_FILE=/workspace/$toolchain \
      -DPython3_EXECUTABLE=/opt/python-3.9/bin/python3.9 \
      -DMERTON_PYTHON_BINDING=$binding
    cmake --build /workspace/$build_dir
  "

test-host: build-host
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  binding="${MERTON_PYTHON_BINDING:-nanobind}"
  docker_network="${DOCKER_NETWORK:-host}"
  case "$compiler" in
    clang) compiler_tag="clang-p2996"; image_name="${IMAGE_NAME:-merton-refl-build}" ;;
    gcc) compiler_tag="gcc-16"; image_name="${IMAGE_NAME:-merton-gcc-16}" ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac
  build_dir="build/${compiler_tag}-${binding}"
  docker run --network "$docker_network" --rm -v "{{root}}:/workspace" "$image_name" bash -lc \
    "merton-build-info && PYTHONPATH=/workspace/$build_dir python3.9 -m pytest /workspace/tests"

copy-module:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  binding="${MERTON_PYTHON_BINDING:-nanobind}"
  module_dest_dir="${MODULE_DEST_DIR:-}"
  case "$compiler" in
    clang) compiler_tag="clang-p2996" ;;
    gcc) compiler_tag="gcc-16" ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac
  build_dir="build/${compiler_tag}-${binding}"
  if [ -z "$module_dest_dir" ]; then
    echo "Set MODULE_DEST_DIR in cpp/.merton-build.env or override it for this command."
    exit 1
  fi
  install -d "$module_dest_dir"
  cp -f "{{root}}/$build_dir/{{module_name}}" "$module_dest_dir/"

# Interactive shell with selected compiler and QuantLib on PATH.
shell:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  case "$compiler" in
    clang) image_name="${IMAGE_NAME:-merton-refl-build}" ;;
    gcc) image_name="${IMAGE_NAME:-merton-gcc-16}" ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac
  docker run -it --rm -v "{{root}}:/workspace" -w /workspace "$image_name" bash

clang-pp *ARGS:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  image_name="${IMAGE_NAME:-merton-refl-build}"
  docker run --rm -v "$PWD:/workspace" -w /workspace "$image_name" clang++ {{ARGS}}

build-local:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  binding="${MERTON_PYTHON_BINDING:-nanobind}"
  case "$compiler" in
    clang) compiler_tag="clang-p2996"; toolchain="toolchain-p2996.cmake" ;;
    gcc) compiler_tag="gcc-16"; toolchain="toolchain-gcc-16.cmake" ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac
  build_dir="build/${compiler_tag}-${binding}"
  rm -rf "{{root}}/$build_dir"
  cmake -S "{{root}}" -B "{{root}}/$build_dir" -G Ninja \
    -DCMAKE_TOOLCHAIN_FILE="{{root}}/$toolchain" \
    -DPython3_EXECUTABLE="/opt/python-3.9/bin/python3.9" \
    -DMERTON_PYTHON_BINDING="$binding"
  cmake --build "{{root}}/$build_dir"

test-local: build-local
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/load-build-env.sh"
  compiler="${COMPILER:-clang}"
  binding="${MERTON_PYTHON_BINDING:-nanobind}"
  case "$compiler" in
    clang) compiler_tag="clang-p2996" ;;
    gcc) compiler_tag="gcc-16" ;;
    *) echo "COMPILER must be clang or gcc (got '$compiler')"; exit 1 ;;
  esac
  build_dir="build/${compiler_tag}-${binding}"
  PYTHONPATH="{{root}}/$build_dir" "/opt/python-3.9/bin/python3.9" -m pytest "{{root}}/tests"

test-compiler-matrix:
  #!/usr/bin/env bash
  set -euo pipefail
  compiler="${COMPILER:-clang}"
  for binding in nanobind pybind11; do
    echo "=== COMPILER=$compiler MERTON_PYTHON_BINDING=$binding ==="
    COMPILER="$compiler" MERTON_PYTHON_BINDING="$binding" just test-host
  done

test-matrix:
  #!/usr/bin/env bash
  set -euo pipefail
  for compiler in clang gcc; do
    for binding in nanobind pybind11; do
      echo "=== MATRIX: COMPILER=$compiler MERTON_PYTHON_BINDING=$binding ==="
      COMPILER="$compiler" MERTON_PYTHON_BINDING="$binding" just test-host
    done
  done

# Smart defaults:
# - On host (docker available): run host recipes
# - In container (docker unavailable): run local recipes
build:
  if command -v docker >/dev/null 2>&1; then just build-host; else just build-local; fi

test:
  if command -v docker >/dev/null 2>&1; then just test-host; else just test-local; fi
