set shell := ["bash", "-cu"]

module_name := "merton_online_calibrator.so"
root := justfile_directory()

default:
  @just test

# Shared env: COMPILER=clang|gcc (default gcc), PYTHON_VERSION=3.14.8|3.13.16 (default 3.14.8).
# Demo perps: MERTON_SYMBOL=BTCUSDT|ETHUSDT|SOLUSDT|XRPUSDT|XAUUSDT
# Effective build dir: build/<compiler_tag>-<binding>-py<major.minor>

setup-defaults:
  #!/usr/bin/env bash
  set -euo pipefail
  cfg="{{root}}/.merton-build.env"
  if [ -f "$cfg" ]; then
    printf "A defaults file already exists at %s. Overwrite it? [y/N]: " "$cfg"
    read -r overwrite
    case "$overwrite" in
      y|Y|yes|YES) ;;
      *) echo "Keeping existing defaults."; exit 0 ;;
    esac
  fi

  echo
  echo "Merton Market Maker build setup"
  echo "This stores your preferred build defaults in cpp/.merton-build.env."
  echo "Environment variables still override these values when needed."
  echo

  echo "1) Compiler toolchain (COMPILER)"
  echo "   - gcc: released GCC 16.2 + libstdc++ (current default)"
  echo "   - clang: Bloomberg Clang P2996 + libc++"
  while :; do
    printf "   Compiler [gcc]: "
    read -r compiler
    compiler=${compiler:-gcc}
    case "$compiler" in
      clang|gcc) break ;;
      *) echo "   Please enter 'clang' or 'gcc'." ;;
    esac
  done

  echo
  echo "2) CPython version (PYTHON_VERSION)"
  echo "   - 3.14.8: default local/CI demo"
  echo "   - 3.13.16: previous stable release"
  while :; do
    printf "   Python [3.14.8]: "
    read -r pyver
    pyver=${pyver:-3.14.8}
    case "$pyver" in
      3.14|3.14.8|3.13|3.13.16) break ;;
      *) echo "   Please enter 3.14.8 or 3.13.16." ;;
    esac
  done

  echo
  echo "3) Python binding backend (MERTON_PYTHON_BINDING)"
  echo "   - nanobind: current default"
  echo "   - pybind11: alternative backend"
  while :; do
    printf "   Binding backend [nanobind]: "
    read -r binding
    binding=${binding:-nanobind}
    case "$binding" in
      nanobind|pybind11) break ;;
      *) echo "   Please enter 'nanobind' or 'pybind11'." ;;
    esac
  done

  echo
  echo "4) Docker networking mode (DOCKER_NETWORK)"
  while :; do
    printf "   Docker network [host]: "
    read -r docker_network
    docker_network=${docker_network:-host}
    case "$docker_network" in
      host|bridge) break ;;
      *) echo "   Please enter 'host' or 'bridge'." ;;
    esac
  done

  echo
  echo "5) Optional module copy destination (MODULE_DEST_DIR)"
  echo "   Used only by: just copy-module (build/test/demo do not copy)."
  printf "   Destination directory [blank]: "
  read -r module_dest_dir

  printf '%s\n' \
    '# Generated by: just setup-defaults' \
    '# Override any of these temporarily by prefixing the just command with env vars.' \
    "COMPILER=$compiler" \
    "PYTHON_VERSION=$pyver" \
    "MERTON_PYTHON_BINDING=$binding" \
    "DOCKER_NETWORK=$docker_network" \
    "MODULE_DEST_DIR=$module_dest_dir" \
    > "$cfg"

  echo
  echo "Saved defaults to $cfg"
  just show-defaults

show-defaults:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  echo "Effective defaults:"
  echo "  COMPILER=$COMPILER"
  echo "  PYTHON_VERSION=$PYTHON_VERSION"
  echo "  PYTHON_MM=$PYTHON_MM"
  echo "  IMAGE_NAME=$image_name"
  echo "  DOCKERFILE=$dockerfile"
  echo "  TOOLCHAIN=$toolchain"
  echo "  BUILD_DIR=$build_dir"
  echo "  MERTON_PYTHON_BINDING=$MERTON_PYTHON_BINDING"
  echo "  DOCKER_NETWORK=$DOCKER_NETWORK"
  echo "  MODULE_DEST_DIR=$MODULE_DEST_DIR"

docker-build:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  docker_network="${DOCKER_NETWORK:-host}"
  build_network="$docker_network"
  if [[ "$build_network" == "bridge" ]]; then
    build_network="default"
  fi
  no_cache_args=()
  if [[ "${DOCKER_NO_CACHE:-0}" == "1" ]]; then
    no_cache_args+=(--pull --no-cache)
  fi
  DOCKER_BUILDKIT=1 docker build "${no_cache_args[@]}" --platform=linux/amd64 --network="$build_network" -t "$image_name" \
    --build-arg PYTHON_VERSION="$PYTHON_VERSION" \
    --build-arg PYTHON_MM="$PYTHON_MM" \
    --build-arg PYTHON_SHA256="$PYTHON_SHA256" \
    -f "{{root}}/$dockerfile" \
    "{{root}}"

docker-build-clean:
  DOCKER_NO_CACHE=1 just docker-build

versions: docker-build
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  docker run --rm "$image_name" merton-build-info

# Compile/run the reflection probe with the selected compiler image.
probe: docker-build
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  docker_network="${DOCKER_NETWORK:-host}"
  case "$COMPILER" in
    clang)
      docker run --network "$docker_network" --rm -v "{{root}}:/workspace" -w /workspace "$image_name" bash -lc '
        set -euo pipefail
        clang++ -std=c++2c -freflection -freflection-latest -fexpansion-statements \
          -stdlib=libc++ -nostdinc++ -O2 \
          -I/opt/clang-p2996/include/c++/v1 \
          -I/opt/clang-p2996/include/x86_64-unknown-linux-gnu/c++/v1 \
          -nostdlib++ \
          /opt/clang-p2996/lib/x86_64-unknown-linux-gnu/libc++.a \
          /opt/clang-p2996/lib/x86_64-unknown-linux-gnu/libc++abi.a \
          -lm -lc -lpthread -lgcc_s \
          -o /tmp/reflection_probe probes/reflection_probe.cpp
        /tmp/reflection_probe
      '
      ;;
    gcc)
      docker run --network "$docker_network" --rm -v "{{root}}:/workspace" -w /workspace "$image_name" bash -lc '
        set -euo pipefail
        g++ -std=c++26 -freflection -fconstexpr-ops-limit=67108864 -O2 \
          -o /tmp/reflection_probe probes/reflection_probe.cpp
        /tmp/reflection_probe
      '
      ;;
  esac

build-host: docker-build
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  docker_network="${DOCKER_NETWORK:-host}"
  docker run --network "$docker_network" --rm -v "{{root}}:/workspace" "$image_name" bash -lc "
    set -euo pipefail
    rm -rf /workspace/$build_dir
    cmake -S /workspace -B /workspace/$build_dir -G Ninja \
      -DCMAKE_TOOLCHAIN_FILE=/workspace/$toolchain \
      -DPython3_EXECUTABLE=$PYTHON_BIN \
      -DMERTON_PYTHON_BINDING=$MERTON_PYTHON_BINDING
    cmake --build /workspace/$build_dir
  "

test-host: build-host
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  docker_network="${DOCKER_NETWORK:-host}"
  repo="$(cd "{{root}}/.." && pwd)"
  docker run --network "$docker_network" --rm \
    -v "{{root}}:/workspace" -v "$repo:/repo" "$image_name" bash -lc \
    "merton-build-info && PYTHONPATH=/workspace/$build_dir:/repo $PYTHON_BIN -m pytest /workspace/tests"

demo: build-host
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  docker_network="${DOCKER_NETWORK:-host}"
  repo="$(cd "{{root}}/.." && pwd)"
  demo_args=()
  if [[ "${MERTON_NO_HISTORY:-0}" == "1" ]]; then
    demo_args+=(--no-history)
  fi
  docker_env=(-e "MERTON_SYMBOL=${MERTON_SYMBOL:-BTCUSDT}" -e "MERTON_MARKET=${MERTON_MARKET:-futures}")
  extra_mounts=()
  for name in MERTON_SIGMA MERTON_LAMBDA MERTON_MU_J MERTON_DELTA_J \
      MERTON_MIN_HALF_SPREAD_BPS MERTON_RISK_HORIZON_SECONDS MERTON_RISK_MULTIPLIER MERTON_PRINT_SECONDS; do
    if [[ -n "${!name:-}" ]]; then
      docker_env+=(-e "$name=${!name}")
    fi
  done
  if [[ -n "${MERTON_MARKET_MAKER_DATA_PATH:-}" ]]; then
    host_path="${MERTON_MARKET_MAKER_DATA_PATH}"
    if [[ "$host_path" != /* ]]; then
      host_path="$repo/$host_path"
    fi
    if [[ -e "$host_path" ]]; then
      abs="$(readlink -f "$host_path")"
      extra_mounts+=(-v "$abs:$abs:ro")
      docker_env+=(-e "MERTON_MARKET_MAKER_DATA_PATH=$abs")
    else
      docker_env+=(-e "MERTON_MARKET_MAKER_DATA_PATH=$host_path")
    fi
  fi
  docker run --network "$docker_network" --rm "${docker_env[@]}" \
    -v "{{root}}:/workspace" -v "$repo:/repo" "${extra_mounts[@]}" -w /repo "$image_name" bash -lc \
    "PYTHONPATH=/workspace/$build_dir:/repo $PYTHON_BIN /repo/scripts/run_binance_demo.py ${demo_args[*]}"

copy-module:
  #!/usr/bin/env bash
  set -euo pipefail
  # shellcheck disable=SC1091
  source "{{root}}/resolve-toolchain.sh"
  if [ -z "$MODULE_DEST_DIR" ]; then
    echo "Set MODULE_DEST_DIR in cpp/.merton-build.env or override it for this command."
    exit 1
  fi
  install -d "$MODULE_DEST_DIR"
  cp -f "{{root}}/$build_dir/{{module_name}}" "$MODULE_DEST_DIR/"

